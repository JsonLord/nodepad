NODEPAD_DATA_DIR=./data
NODEPAD_STORE=file
NODEPAD_HEARTBEAT_ENABLED=true
NODEPAD_HEARTBEAT_INTERVAL_SECONDS=900
NODEPAD_HEARTBEAT_MODE=normal
NODEPAD_RESEARCH_ENABLED=true
NODEPAD_MAX_RESEARCH_TASKS_PER_HEARTBEAT=5
NODEPAD_MAX_COST_CLASS=free
NODEPAD_GITHUB_SYNC=false
NODEPAD_GITHUB_REPOSITORY=
NODEPAD_GITHUB_BRANCH=nodepad-backup
NODEPAD_GITHUB_PATH=nodepad-workspaces
NODEPAD_GITHUB_TOKEN=
NODEPAD_GITHUB_CREATE_BRANCH=true
NODEPAD_GITHUB_MIN_COMMIT_INTERVAL_SECONDS=600
NODEPAD_EVIDENCE_STALE_DAYS=365
NODEPAD_BACKUP_REPO=
NODEPAD_WEB_SEARCH_ENDPOINT=
NODEPAD_LOGIN_KEY=
# Set true only behind a trusted proxy that appends/overwrites X-Forwarded-For.
NODEPAD_TRUST_PROXY=false
# Optional private session directory; default is NODEPAD_DATA_DIR/.auth
NODEPAD_AUTH_DIR=
NODEPAD_API_KEY=
OPENAI_URL=
OPENAI_API=
OPENAI_MODEL=

# Optional semantic retrieval/matching. Never controls qualification.
NODEPAD_EMBEDDING_ENABLED=false
NODEPAD_EMBEDDING_PROVIDER=ollama
NODEPAD_EMBEDDING_URL=http://127.0.0.1:11434
NODEPAD_EMBEDDING_MODEL=embeddinggemma2
NODEPAD_EMBEDDING_TIMEOUT_MS=5000
NODEPAD_EMBEDDING_EVIDENCE_DUP_THRESHOLD=0.92
NODEPAD_EMBEDDING_HYPOTHESIS_DUP_THRESHOLD=0.90
NODEPAD_EMBEDDING_RELEVANCE_THRESHOLD=0.35
NODEPAD_EMBEDDING_THEME_THRESHOLD=0.80
