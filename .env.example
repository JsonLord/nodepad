NODE_ENV=production
NEXT_PUBLIC_NODEPAD_STORAGE_MODE=browser
NODEPAD_API_TOKEN=
NODEPAD_DATA_DIR=.nodepad-data
# NODEPAD_DB_PATH=/var/lib/nodepad/nodepad.sqlite
NODEPAD_BACKUP_DIR=.nodepad-data/backups
NODEPAD_BACKUP_KEEP_COUNT=14
NODEPAD_MAX_REQUEST_BYTES=26214400
# NODEPAD_COOKIE_SECURE=true  # optional override; production already enables Secure cookies

# Remote Laya decision provider (server-only; Nodepad never hosts the model)
LAYA_PROVIDER=remote_openai
LAYA_BASE_URL=https://laya.example/v1
LAYA_API_KEY=
LAYA_MODEL=laya
LAYA_REQUEST_TIMEOUT_MS=10000
LAYA_MAX_CONCURRENT_REQUESTS=4
LAYA_MAX_QUEUE_SIZE=8
LAYA_MIN_CONFIDENCE=0.70
LAYA_MIN_MARGIN=0.15
LAYA_MAX_CANDIDATES=12

# AGTX MCP execution (server-only; execution is opt-in)
AGTX_BINARY=/usr/local/bin/agtx
AGTX_MCP_MODE=global
AGTX_REQUEST_TIMEOUT_MS=15000
AGTX_PROJECT_ROOTS=/srv/repos
AGTX_EXECUTION_ENABLED=false
AGTX_AUTO_COMPLETE_NODEPAD_TASK=false
